<mujoco model="simple_arm">
  <!-- A 3-joint planar arm -- deliberately simple (design doc §4: "no
       full inverse kinematics," joint-space control only). Each joint
       gets a velocity actuator, so the control signal this scene
       expects is exactly what System 1's controller already computes:
       a per-joint target velocity, no further conversion needed when
       the real loop gets wired together in M4. -->
  <!-- implicitfast: the velocity actuators + joint damping below form a
       stiff system that the default semi-implicit Euler integrator
       diverges on within milliseconds (confirmed -- qvel/qpos blew up
       to the thousands within 10-20 steps before this was found and
       fixed) -- implicitfast handles exactly this combination stably,
       and geom mass is left for MuJoCo to auto-compute from density
       rather than hand-overridden, which was part of the same
       instability. -->
  <option gravity="0 0 -9.81" timestep="0.002" integrator="implicitfast"/>

  <worldbody>
    <geom name="floor" type="plane" size="2 2 0.1" rgba="0.8 0.8 0.8 1"/>
    <body name="link1" pos="0 0 0.5">
      <joint name="joint1" type="hinge" axis="0 1 0" range="-3.14159 3.14159" damping="2.0"/>
      <geom type="capsule" size="0.05" fromto="0 0 0 0.3 0 0" rgba="0.8 0.2 0.2 1"/>
      <body name="link2" pos="0.3 0 0">
        <joint name="joint2" type="hinge" axis="0 1 0" range="-3.14159 3.14159" damping="1.5"/>
        <geom type="capsule" size="0.04" fromto="0 0 0 0.25 0 0" rgba="0.2 0.8 0.2 1"/>
        <body name="link3" pos="0.25 0 0">
          <joint name="joint3" type="hinge" axis="0 1 0" range="-3.14159 3.14159" damping="1.0"/>
          <geom type="capsule" size="0.03" fromto="0 0 0 0.2 0 0" rgba="0.2 0.2 0.8 1"/>
          <site name="end_effector" pos="0.2 0 0" size="0.02"/>
        </body>
      </body>
    </body>
  </worldbody>

  <actuator>
    <velocity name="act1" joint="joint1" kv="10"/>
    <velocity name="act2" joint="joint2" kv="10"/>
    <velocity name="act3" joint="joint3" kv="10"/>
  </actuator>
</mujoco>
